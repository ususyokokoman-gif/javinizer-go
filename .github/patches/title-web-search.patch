+func javResultTrustWeight(raw string) float64 {
+	parsed, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil || parsed.Hostname() == "" {
+		return 0
+	}
+	host := strings.ToLower(strings.TrimSuffix(parsed.Hostname(), "."))
+	for _, official := range []string{"dmm.co.jp", "dmm.com", "fanza.co.jp", "mgstage.com", "r18.dev", "r18.com"} {
+		if host == official || strings.HasSuffix(host, "."+official) {
+			return 1.75
+		}
+	}
+	for _, catalog := range []string{"javdb.com", "javlibrary.com", "javbus.com", "av-entertainments.com"} {
+		if host == catalog || strings.HasSuffix(host, "."+catalog) {
+			return 1.0
+		}
+	}
+	return 0
+}
+
+func extractTrustedURLCatalogCandidates(raw string) []string {
+	if javResultTrustWeight(raw) == 0 {
+		return nil
+	}
+	parsed, err := url.Parse(strings.TrimSpace(raw))
+	if err != nil {
+		return nil
+	}
+
+	values := make([]string, 0, 12)
+	for _, key := range []string{"cid", "content_id", "contentid", "product_id", "productid", "pid"} {
+		values = append(values, parsed.Query()[key]...)
+	}
+	for _, segment := range strings.Split(parsed.EscapedPath(), "/") {
+		decoded, err := url.PathUnescape(segment)
+		if err != nil {
+			decoded = segment
+		}
+		decoded = strings.TrimSpace(decoded)
+		if strings.HasPrefix(strings.ToLower(decoded), "cid=") {
+			decoded = decoded[4:]
+		}
+		if decoded != "" {
+			values = append(values, decoded)
+		}
+	}
+
+	seen := make(map[string]struct{})
+	out := make([]string, 0, 2)
+	for _, value := range values {
+		if id, ok := normalizeTrustedCompactCatalogID(value); ok {
+			key := catalogComparable(id)
+			if _, exists := seen[key]; exists {
+				continue
+			}
+			seen[key] = struct{}{}
+			out = append(out, id)
+		}
+	}
+	return out
+}
+
+func normalizeTrustedCompactCatalogID(raw string) (string, bool) {
+	value := strings.TrimSpace(norm.NFKC.String(raw))
+	value = strings.Trim(value, " .,:;!?/\\[](){}")
+	if idx := strings.IndexAny(value, "?#"); idx >= 0 {
+		value = value[:idx]
+	}
+	match := trustedCompactIDRE.FindStringSubmatch(value)
+	if len(match) != 3 {
+		return "", false
+	}
+	digits := match[2]
+	for len(digits) > 3 && strings.HasPrefix(digits, "0") {
+		digits = digits[1:]
+	}
+	id := strings.ToUpper(match[1]) + "-" + digits
+	if normalizeWebCatalogCandidate(id) == "" {
+		return "", false
+	}
+	return id, true
+}
+
+func mergeCatalogIDs(groups ...[]string) []string {
+	seen := make(map[string]struct{})
+	out := make([]string, 0)
+	for _, group := range groups {
+		for _, id := range group {
+			key := catalogComparable(id)
+			if key == "" {
